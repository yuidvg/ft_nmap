cabal-version: 2.4
name: e2e
version: 0.1.0.0
build-type: Simple

executable e2e
  hs-source-dirs: .
  main-is: Main.hs
  default-language: GHC2021
  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

  ghc-options:
    -Wall
    -Wextra
    -Werror
    -O2

  build-depends:
    base >=4.14 && <5,
    containers,
    directory,
    filepath,
    hxt,
    pretty-show,
    process,
    semialign,
    tasty,
    tasty-hunit,
    these,
