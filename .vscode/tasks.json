{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make-app-debug",
            "type": "shell",
            "command": "make -j app-debug",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build-test",
            "type": "shell",
            "command": "make test",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build-debug",
            "type": "shell",
            "command": "make debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build-current-file",
            "type": "shell",
            "command": "mkdir -p ${workspaceFolder}/build/bin/${relativeFileDirname} && gcc -g3 -O0 -I ${workspaceFolder}/include ${file} -o ${workspaceFolder}/build/bin/${relativeFile}-debug.out",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}