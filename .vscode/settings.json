{
    "git.ignoreLimitWarning": true,
    "files.associations": {
        "*.h": "c",
        "array": "c",
        "deque": "c",
        "string": "c",
        "unordered_map": "c",
        "vector": "c",
        "iterator": "c",
        "string_view": "c",
        "type_traits": "c",
        "cstddef": "c",
        "memory_resource": "c",
        "random": "c"
    },
    
    "C_Cpp.default.compileCommands": "${workspaceFolder}/compile_commands.json",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}",
        "--query-driver=/nix/store/*/bin/clang*"
    ]
}